# ==============================================================================
# HERMES PRODUCTION CONFIGURATION TEMPLATE (v1.0.0-rc1)
# ==============================================================================
# Copy this file to .env and configure your API credentials.
#
# Locked Model Stack:
#   Tier 1: NVIDIA NIM / z-ai/glm-5.3-flash
#   Tier 2: Ollama Cloud / gpt-oss:120b-cloud
#   Tier 3: Ollama Cloud / nemotron-3-ultra:cloud
# ==============================================================================

# --- Mandatory Credentials ---
# NVIDIA NIM API key for Tier 1 model generation
NVIDIA_API_KEY=your_nvidia_nim_api_key_here

# --- Tier 1 Configuration (Generation & Tool Execution) ---
TIER1_PROVIDER=nvidia_nim
TIER1_MODEL=z-ai/glm-5.3-flash
TIER1_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Tier 2 Configuration (Verification & Quality Gate) ---
TIER2_PROVIDER=ollama
TIER2_MODEL=gpt-oss:120b-cloud
OLLAMA_BASE_URL=http://localhost:11434

# --- Tier 3 Configuration (Arbitration & Escalation) ---
TIER3_PROVIDER=ollama
TIER3_MODEL=nemotron-3-ultra:cloud

# --- Network & Execution Timeouts ---
MODEL_TIMEOUT_SECONDS=360
VERIFICATION_TIMEOUT_SECONDS=30
MEMORY_EXTRACTION_TIMEOUT_SECONDS=60
MODEL_KEEP_ALIVE=300s
MODEL_STREAMING=true

# --- Runtime Subsystems ---
PROGRESSIVE_VERIFICATION_ENABLED=true
ADAPTIVE_T1_BUDGET_ENABLED=true
OPTIMIZED_MODEL_RESIDENCY_ENABLED=true
ROBUST_TOOL_VALIDATION_ENABLED=true
WORKSPACE_INTELLIGENCE_ENABLED=true
CONTEXT_ENGINE_ENABLED=true
ADAPTIVE_EXECUTION_ENABLED=true
KAIROS_DAG_ENABLED=true
KAIROS_MAX_CONCURRENCY=4
INTELLIGENT_ROUTING_ENABLED=true
MISSION_COMPLETION_ENGINE_ENABLED=true
MAX_MISSION_REPAIR_ATTEMPTS=3
MAX_DYNAMIC_TASKS=5
EVENT_BUS_ENABLED=true
EVENT_BUS_BUFFER_SIZE=1000

# --- Verification & Risk Thresholds ---
T2_CONFIDENCE_THRESHOLD=0.70
HIGH_RISK_THRESHOLD=0.60

# --- Optional Secondary Fallback (OpenRouter) ---
# OPENROUTER_API_KEY=your_openrouter_api_key_if_applicable
