{
  "schema_version": 2,
  "database_type": "SQLite3 (WAL mode, PRAGMA synchronous = NORMAL, foreign_keys = ON)",
  "canonical_storage_path": "%LOCALAPPDATA%\\HERMES\\hermes_runtime.db",
  "override_environment_variable": "HERMES_DATABASE_PATH",
  "tables": [
    {
      "name": "schema_version",
      "purpose": "Version migration tracking and schema integrity.",
      "columns": ["version INTEGER PRIMARY KEY", "applied_at REAL NOT NULL", "description TEXT NOT NULL"]
    },
    {
      "name": "global_sequences",
      "purpose": "Crash-safe atomic sequence allocation across threads and restarts.",
      "columns": ["generator_key TEXT PRIMARY KEY", "current_sequence INTEGER NOT NULL DEFAULT 0"]
    },
    {
      "name": "mission_events",
      "purpose": "Durable append-only journal for every accepted mission event.",
      "columns": [
        "sequence INTEGER PRIMARY KEY",
        "mission_id TEXT NOT NULL",
        "session_id TEXT",
        "run_id TEXT",
        "attempt_number INTEGER NOT NULL DEFAULT 1",
        "event_id TEXT NOT NULL",
        "event_type TEXT NOT NULL",
        "timestamp REAL NOT NULL",
        "payload_hash TEXT NOT NULL",
        "payload_json TEXT NOT NULL",
        "schema_version INTEGER NOT NULL DEFAULT 1"
      ],
      "indexes": ["idx_mission_events_mission (mission_id, sequence)", "idx_mission_events_run (run_id, sequence)"]
    },
    {
      "name": "missions",
      "purpose": "Authoritative mission execution and lifecycle records surviving process restarts.",
      "columns": [
        "mission_id TEXT PRIMARY KEY",
        "session_id TEXT",
        "run_id TEXT",
        "attempt_number INTEGER NOT NULL DEFAULT 1",
        "workspace_path TEXT NOT NULL",
        "status TEXT NOT NULL",
        "wait_reason TEXT NOT NULL DEFAULT 'NONE'",
        "prompt TEXT NOT NULL DEFAULT ''",
        "created_at REAL NOT NULL",
        "updated_at REAL NOT NULL",
        "state_version INTEGER NOT NULL DEFAULT 0",
        "last_event_sequence INTEGER NOT NULL DEFAULT 0",
        "latest_checkpoint_id TEXT",
        "execution_active INTEGER NOT NULL DEFAULT 0",
        "recovery_required INTEGER NOT NULL DEFAULT 0",
        "error_json TEXT NOT NULL DEFAULT '{}'",
        "metadata_json TEXT NOT NULL DEFAULT '{}'"
      ]
    },
    {
      "name": "snapshots",
      "purpose": "Full authoritative HermesRuntimeState snapshots for instantaneous rehydration.",
      "columns": [
        "mission_id TEXT PRIMARY KEY",
        "session_id TEXT",
        "run_id TEXT",
        "attempt_number INTEGER NOT NULL DEFAULT 1",
        "schema_version INTEGER NOT NULL DEFAULT 1",
        "state_version INTEGER NOT NULL DEFAULT 0",
        "last_event_sequence INTEGER NOT NULL DEFAULT 0",
        "workspace_path TEXT NOT NULL",
        "status TEXT NOT NULL",
        "snapshot_json TEXT NOT NULL",
        "created_at REAL NOT NULL",
        "state_hash TEXT NOT NULL"
      ]
    },
    {
      "name": "verification_evidence",
      "purpose": "Durably journals external test command execution, exit codes, and output summaries.",
      "columns": [
        "evidence_id TEXT PRIMARY KEY",
        "mission_id TEXT NOT NULL",
        "run_id TEXT",
        "command TEXT NOT NULL",
        "working_dir TEXT NOT NULL",
        "interpreter TEXT NOT NULL",
        "exit_code INTEGER NOT NULL",
        "duration_seconds REAL NOT NULL DEFAULT 0.0",
        "output_summary TEXT NOT NULL DEFAULT ''",
        "status TEXT NOT NULL",
        "rationale TEXT NOT NULL DEFAULT ''",
        "created_at REAL NOT NULL"
      ],
      "indexes": ["idx_verification_mission (mission_id)"]
    },
    {
      "name": "sessions",
      "purpose": "Historical execution lineages, forks, and branch lineages.",
      "columns": [
        "session_id TEXT PRIMARY KEY",
        "parent_session_id TEXT",
        "root_session_id TEXT",
        "mission_id TEXT NOT NULL",
        "workspace_root TEXT NOT NULL",
        "status TEXT NOT NULL",
        "current_checkpoint_id TEXT",
        "current_sequence INTEGER NOT NULL DEFAULT 0",
        "created_at REAL NOT NULL",
        "updated_at REAL NOT NULL",
        "branch_name TEXT NOT NULL DEFAULT 'main'",
        "metadata_json TEXT NOT NULL DEFAULT '{}'"
      ]
    },
    {
      "name": "checkpoints",
      "purpose": "Cryptographically hashed checkpoint manifests bound to CAS file blobs.",
      "columns": [
        "checkpoint_id TEXT PRIMARY KEY",
        "session_id TEXT NOT NULL",
        "parent_checkpoint_id TEXT",
        "sequence INTEGER NOT NULL",
        "reason TEXT NOT NULL",
        "trigger TEXT NOT NULL",
        "created_at REAL NOT NULL",
        "state_hash TEXT NOT NULL",
        "manifest_hash TEXT NOT NULL",
        "manifest_json TEXT NOT NULL"
      ],
      "indexes": ["idx_checkpoints_session (session_id, sequence)"]
    }
  ]
}
